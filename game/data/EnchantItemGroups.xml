		<current enchant="16-65535" chance="0" />
	</enchantRateGroup>

	<!-- Blessed Scroll armor enchant group. -->
	<enchantRateGroup name="BLESSED_ARMOR_GROUP">
		<current enchant="0-2" chance="100" />
		<current enchant="3-15" chance="66" />
		<current enchant="16" chance="70" />
		<current enchant="17" chance="50" />
		<current enchant="18" chance="30" />
		<current enchant="19" chance="10" />
		<current enchant="20-65535" chance="0" />
	</enchantRateGroup>

	<!-- Blessed Scroll full armor enchant group. -->
	<enchantRateGroup name="BLESSED_FULL_ARMOR_GROUP">
		<current enchant="0-3" chance="100" />
		<current enchant="4-15" chance="66" />
		<current enchant="16" chance="70" />
		<current enchant="17" chance="50" />
		<current enchant="18" chance="30" />
		<current enchant="19" chance="10" />
		<current enchant="20-65535" chance="0" />
	</enchantRateGroup>

	<!-- Blessed Scroll fighter weapon enchant group. -->
	<enchantRateGroup name="BLESSED_FIGHTER_WEAPON_GROUP">
		<current enchant="0-2" chance="100" />
		<current enchant="3-15" chance="66" />
		<current enchant="16" chance="70" />
		<current enchant="17" chance="50" />
		<current enchant="18" chance="30" />
		<current enchant="19" chance="10" />
		<current enchant="20-65535" chance="0" />
	</enchantRateGroup>

	<!-- Blessed Scroll mage weapon enchant group. -->
	<enchantRateGroup name="BLESSED_MAGE_WEAPON_GROUP">
		<current enchant="0-2" chance="100" />
		<current enchant="3-15" chance="66" />
		<current enchant="16" chance="70" />
		<current enchant="17" chance="50" />
		<current enchant="18" chance="30" />
		<current enchant="19" chance="10" />
		<current enchant="20-65535" chance="0" />
	</enchantRateGroup>


	<!-- Divine Crystal: 100% success all enchant levels -->
	<enchantRateGroup name="DIVINE_GROUP">
		<current enchant="0-65535" chance="100" />
	</enchantRateGroup>
	<!-- Default scrolls enchanting route line. -->
	<enchantScrollGroup id="0">
		<!-- Bind armor group to all item slots except full armor. -->
		<enchantRate group="ARMOR_GROUP">
			<item slot="lhand" /> <!-- Left hand: Shields, Sigils -->
			<item slot="head" /> <!-- Head: Helmet -->
			<item slot="chest" /> <!-- Chest: Armor upper body. -->
			<item slot="legs" /> <!-- Legs: Armor lower body. -->
			<item slot="feet" /> <!-- Feet: Boots -->
			<item slot="gloves" /> <!-- Gloves: Gloves -->
			<item slot="neck" /> <!-- Neck: Necklaces -->
			<item slot="rear;lear" /> <!-- Right ear, Left ear: Earrings -->
			<item slot="rfinger;lfinger" /> <!-- Right finger, Left finger: Rings -->
			<item slot="belt" /> <!-- Belt: Belts -->
			<item slot="shirt" /> <!-- Shirt: Shirts -->
		</enchantRate>
		<!-- Bind only full armor group to to full armor slot items. -->
		<enchantRate group="FULL_ARMOR_GROUP">
			<item slot="fullarmor" /> <!-- Full Armor: Full armor pants are included. -->
		</enchantRate>
		<!-- Bind only fighter weapon group to all fighter weapons. -->
		<enchantRate group="FIGHTER_WEAPON_GROUP">
			<item slot="rhand" magicWeapon="false" /> <!-- Right hand: Weapons, Non magic weapon -->
			<item slot="lrhand" magicWeapon="false" /> <!-- Two hands: Weapons, Non magic weapon -->
		</enchantRate>
		<!-- Bind only mage weapon group to all magic weapons. -->
		<enchantRate group="MAGE_WEAPON_GROUP">
			<item slot="rhand" magicWeapon="true" /> <!-- Right hand: Weapons, Magic weapon -->
			<item slot="lrhand" magicWeapon="true" /> <!-- Two hands: Weapons, Magic weapon -->
		</enchantRate>
	</enchantScrollGroup>


	<enchantScrollGroup id="2">
		<enchantRate group="DIVINE_GROUP">
			<item slot="lhand" />
			<item slot="head" />
			<item slot="chest" />
			<item slot="legs" />
			<item slot="feet" />
			<item slot="gloves" />
			<item slot="neck" />
			<item slot="rear;lear" />
			<item slot="rfinger;lfinger" />
			<item slot="belt" />
			<item slot="shirt" />
			<item slot="fullarmor" />
			<item slot="rhand" magicWeapon="false" />
			<item slot="lrhand" magicWeapon="false" />
			<item slot="rhand" magicWeapon="true" />
			<item slot="lrhand" magicWeapon="true" />
		</enchantRate>
	</enchantScrollGroup>

	<enchantScrollGroup id="1">
		<enchantRate group="BLESSED_ARMOR_GROUP">
			<item slot="lhand" />
			<item slot="head" />
			<item slot="chest" />
			<item slot="legs" />
			<item slot="feet" />
			<item slot="gloves" />
			<item slot="neck" />
			<item slot="rear;lear" />
			<item slot="rfinger;lfinger" />
			<item slot="belt" />
			<item slot="shirt" />
		</enchantRate>
		<enchantRate group="BLESSED_FULL_ARMOR_GROUP">
			<item slot="fullarmor" />
		</enchantRate>
		<enchantRate group="BLESSED_FIGHTER_WEAPON_GROUP">
			<item slot="rhand" magicWeapon="false" />
			<item slot="lrhand" magicWeapon="false" />
		</enchantRate>
		<enchantRate group="BLESSED_MAGE_WEAPON_GROUP">
			<item slot="rhand" magicWeapon="true" />
			<item slot="lrhand" magicWeapon="true" />
		</enchantRate>
	</enchantScrollGroup>
</list>
